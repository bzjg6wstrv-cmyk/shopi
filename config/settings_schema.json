  {
    "name": "Logo & Marke",
    "settings": [
      {
        "type": "paragraph",
        "content": "Zwei getrennte Elemente: die Wortmarke VENT CELESTE als Schriftzug und das Signet als Bildmarke. Solange nichts hinterlegt ist, zeigt das Theme die Wortmarke als Text."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "textarea",
        "id": "logo_svg",
        "label": "Logo als Inline-SVG",
        "info": "Optional und gegenüber einer Bilddatei bevorzugt: gestochen scharf, beliebig skalierbar, und die Farbe folgt automatisch dem Farbschema. Den Inhalt der SVG-Datei hier einfügen. Wird verwendet, sobald etwas eingetragen ist."
      },
      {
        "type": "header",
        "content": "Signet"
      },
      {
        "type": "image_picker",
        "id": "signet",
        "label": "Signet (Bildmarke)",
        "info": "Die Originaldatei mit transparentem Hintergrund. Erscheint im Kopfbereich neben der Wortmarke, im mobilen Menü und im Fußbereich."
      },
      {
        "type": "checkbox",
        "id": "signet_recolor",
        "label": "Signet automatisch einfärben",
        "default": true,
        "info": "Empfohlen. Das Signet wird als Maske verwendet und übernimmt die Textfarbe des Abschnitts: tiefes Schwarz auf hellen Flächen, Elfenbein auf schwarzen. Voraussetzung ist ein transparenter Hintergrund. Ausschalten, wenn die Originalfarben erhalten bleiben sollen."
      },
      {
        "type": "range",
        "id": "signet_size_header",
        "min": 14,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Signethöhe im Kopfbereich",
        "default": 22
      },
      {
        "type": "range",
        "id": "signet_size_footer",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Signethöhe im Fußbereich",
        "default": 56
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logobreite Desktop",
        "default": 180
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 60,
        "max": 220,
        "step": 10,
        "unit": "px",
        "label": "Logobreite Mobile",
        "default": 130
      },
      {
        "type": "text",
        "id": "wordmark",
        "label": "Wortmarke (Textlogo)",
        "default": "VENT CELESTE",
        "info": "Wird angezeigt, wenn kein Logo hochgeladen ist."
      },
      {
        "type": "range",
        "id": "wordmark_tracking",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "/100em",
        "label": "Laufweite Wortmarke",
        "default": 22
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
