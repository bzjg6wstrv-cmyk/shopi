      "options": [
        { "value": "impressum", "label": "Impressum" },
        { "value": "datenschutz", "label": "Datenschutzerklärung" },
        { "value": "versand", "label": "Versand & Zahlung" },
        { "value": "garantie", "label": "Zufriedenheitsgarantie" },
