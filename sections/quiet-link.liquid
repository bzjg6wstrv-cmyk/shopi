{%- comment -%}
  Eine einzelne, ruhige Zeile mit Haarlinien – für Inhalte, die sichtbar,
  aber bewusst nachgeordnet sein sollen (etwa die Einstiegslinie).
  Sie steht nie neben dem Preis der Hauptlinie.
{%- endcomment -%}
<section class="section section--tight color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    <div class="quiet-row reveal">
      <div class="quiet-row__main">
        <span class="quiet-row__title">{{ section.settings.heading | escape }}</span>
        {%- if section.settings.text != blank -%}
          <span class="quiet-row__text">{{ section.settings.text | escape }}</span>
        {%- endif -%}
      </div>
      {%- liquid
        capture quiet_link
          render 'link-pruefen', url: section.settings.link
        endcapture
        assign quiet_link = quiet_link | strip
      -%}
      {%- if quiet_link != blank -%}
        <a class="link-underline" href="{{ quiet_link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ruhige Zeile",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Essentials · 30 ml · ab 9,90 €"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Eine eigene Einstiegslinie für den Alltag."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Textlink",
      "default": "Ansehen"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Ziel"
    }
  ],
  "presets": [
    {
      "name": "Ruhige Zeile"
    }
  ]
}
{% endschema %}
