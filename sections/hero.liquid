{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section
  class="hero hero--{{ section.settings.height }}{% if section.settings.alignment == 'center' %} hero--center{% endif %}{% unless has_image %} hero--plain{% endunless %} color-{{ section.settings.color_scheme }} color-scheme"
>
  {%- if has_image -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1500 }} 1500w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
      {%- if section.settings.scrim > 0 -%}
        <div class="hero__scrim" style="background-color: rgb(var(--color-background) / {{ section.settings.scrim | divided_by: 100.0 }});"></div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hero__content page-width">
    <div class="hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <p class="hero__title h1">{{ section.settings.heading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hero__text text-lead">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a class="button button--secondary" href="{{ section.settings.secondary_link }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Empfohlen: ruhiger Hintergrund, Glas, Licht und Schatten. Ohne Bild entsteht eine reine Typo-Fläche."
    },
    {
      "type": "range",
      "id": "scrim",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Abdunklung/Aufhellung des Bildes",
      "default": 25,
      "info": "Sichert die Lesbarkeit. Verwendet die Hintergrundfarbe des gewählten Schemas."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Höhe",
      "options": [
        {
          "value": "short",
          "label": "Niedrig"
        },
        {
          "value": "medium",
          "label": "Mittel"
        },
        {
          "value": "tall",
          "label": "Hoch"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Textausrichtung",
      "options": [
        {
          "value": "left",
          "label": "Links unten"
        },
        {
          "value": "center",
          "label": "Mittig"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleiner Vortext"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "VENT CELESTE"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Markenbotschaft",
      "default": "Konzentrierte Duftkompositionen. Klar kalkuliert."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primärer Button",
      "default": "Düfte entdecken"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link primärer Button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundärer Button",
      "default": "Discovery Set"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link sekundärer Button"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
