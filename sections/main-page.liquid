<section class="section">
  <div class="page-width page-width--narrow">
    <h1 class="h2">{{ page.title }}</h1>
    <div class="rte measure" style="margin-top: var(--space-xl);">{{ page.content }}</div>

    {%- if section.settings.show_placeholder_note -%}
      <p class="demo-flag" style="margin-top: var(--space-2xl);">{{ 'general.demo_notice' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Seite",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_placeholder_note",
      "label": "Als Platzhalterinhalt kennzeichnen",
      "default": false,
      "info": "Für Rechtsseiten mit Musterdaten aktivieren, bis echte Angaben vorliegen."
    }
  ]
}
{% endschema %}
