<section class="section">
  <div class="page-width">
    <h1 class="h2" style="margin-bottom: var(--space-xl);">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="stack">
        <p class="text-lead">{{ 'sections.cart.empty' | t }}</p>
        <p class="text-muted measure-narrow">{{ 'sections.cart.empty_help' | t }}</p>
        <p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></p>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate data-no-ajax>
        <ul class="cart-items" style="max-width: 46rem;">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="" width="72" height="96" loading="lazy">
                {%- endif -%}
              </a>
              <div>
                <p class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}

                {%- assign has_props = false -%}
                {%- for property in item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}{%- assign has_props = true -%}{%- endif -%}
                {%- endfor -%}
                {%- if has_props -%}
                  <dl class="cart-item__properties">
                    {%- for property in item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and first_char != '_' -%}
                        <div><dt>{{ property.first | escape }}:</dt> <dd>{{ property.last | escape }}</dd></div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}

                <div class="cart-item__row">
                  <div class="quantity" data-quantity>
                    <button type="button" data-quantity-step="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <label class="visually-hidden" for="CartPageQty-{{ forloop.index }}">{{ 'products.product.quantity' | t }}</label>
                    <input id="CartPageQty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="1" inputmode="numeric">
                    <button type="button" data-quantity-step="1" aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <span>{{ item.final_line_price | money }}</span>
                </div>

                <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'sections.cart.remove' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div style="max-width: 46rem; margin-top: var(--space-2xl);">
          {%- if settings.cart_show_note -%}
            <div class="field cart-note">
              <label class="field__label" for="CartPageNote">{{ 'sections.cart.note' | t }}</label>
              <textarea class="field__input" id="CartPageNote" name="note" rows="3">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-footer__row" style="margin-top: var(--space-lg);">
            <span class="meta meta--muted">{{ 'sections.cart.subtotal' | t }}</span>
            <span class="cart-footer__total">{{ cart.total_price | money }}</span>
          </div>

          <p class="text-muted" style="font-size: .75rem;">{{ settings.tax_note }}. {{ 'sections.cart.taxes_note' | t }}</p>

          <div style="display:flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-lg);">
            <button type="submit" name="update" class="button button--secondary">{{ 'sections.cart.update' | t }}</button>
            <button type="submit" name="checkout" class="button">{{ 'sections.cart.checkout' | t }}</button>
          </div>

          {%- if additional_checkout_buttons -%}
            <div style="margin-top: var(--space-lg);">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Warenkorb",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
