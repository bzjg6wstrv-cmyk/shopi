{{ 'section-product.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Produktseite. Der Inhaltsbereich rechts ist blockbasiert und im
  Theme-Editor sortierbar. Alle Duftangaben stammen aus Metafeldern;
  fehlt ein Metafeld, entfällt der Block ersatzlos.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign families = product.metafields.custom.duftfamilie.value
  assign character = product.metafields.custom.charakter.value
  assign seasons = product.metafields.custom.jahreszeit.value
  assign occasions = product.metafields.custom.anlass.value
  assign intensity = product.metafields.custom.intensitaet.value
  assign gender = product.metafields.custom.geschlecht.value

  assign option_name = product.options_with_values.first.name
  if option_name == blank or option_name == 'Title'
    assign option_name = 'products.product.variant_label' | t
  endif

  comment
    Ist dies das zentrale Produkt für nicht gelistete Scent Codes? Nur dann
    erscheint weiter unten die Code-Eingabe. Für jedes andere Produkt ist die
    Ausgabe dieser Datei unverändert.
  endcomment
  assign sc_product = settings.scent_code_product
  if sc_product == blank
    assign sc_product = all_products['vent-celeste-scent-code']
  endif
  assign is_scent_code_product = false
  if sc_product != blank and sc_product.handle == product.handle
    assign is_scent_code_product = true
  endif
-%}
<section class="section">
  <div class="page-width">
    <div class="product">
      <div class="product__media">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <img
              data-media-id="{{ media.id }}"
              src="{{ media | image_url: width: 1400 }}"
              srcset="{{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 900 }} 900w,
                      {{ media | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 990px) 55vw, 100vw"
              alt="{{ media.alt | default: product.title | escape }}"
              width="{{ media.width }}"
              height="{{ media.height }}"
              {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            >
          {%- endfor -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'full-bleed-media' }}
        {%- endif -%}
      </div>

      <div class="product__info">
        <h1 class="product__title h2">{{ product.title }}</h1>

        {%- if families != blank or character != blank -%}
          <p class="product__meta">
            {%- if families != blank %}{{ families | join: ' · ' }}{% endif -%}
            {%- if families != blank and character != blank %} · {% endif -%}
            {%- if character != blank %}{{ character | join: ' · ' }}{% endif -%}
          </p>
        {%- endif -%}

        {%- capture current_variant_line -%}{% render 'variant-facts', variant: current_variant, mode: 'line' %}{%- endcapture -%}
        {%- assign current_variant_line = current_variant_line | strip -%}
        <p class="meta meta--muted" style="margin-top: var(--space-xs);" data-variant-meta{% if current_variant_line == blank %} hidden{% endif %}>
          {{ current_variant_line }}
        </p>

        {% render 'product-reviews', product: product %}

        <div class="product__price" data-product-price>
          {% render 'product-price', variant: current_variant, product: product %}
        </div>

        {%- if section.settings.show_sku -%}
          <p class="product__note" data-variant-sku{% if current_variant.sku == blank %} hidden{% endif %}>
            {{ 'products.product.sku' | t }}: <span data-variant-sku-value>{{ current_variant.sku }}</span>
          </p>
        {%- endif -%}

        {%- if is_scent_code_product -%}
          {% render 'scent-code-inline' %}
        {%- endif -%}

        <div class="product-form">
          {%- form 'product', product, id: 'ProductForm', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- if is_scent_code_product -%}
              {%- comment -%}
                Die beiden Angaben reisen mit dem regulären Absenden mit und
                landen als Positionsangabe im Warenkorb, im Checkout und in der
                Bestellung. Gefüllt werden sie von scent-code-order.js.
              {%- endcomment -%}
              <input type="hidden" name="properties[{{ 'sections.scent_code.code_in_order' | t }}]" value="" data-code-property>
              <input type="hidden" name="properties[_vc_code]" value="" data-code-property-hidden>
            {%- endif -%}

            {%- unless product.has_only_default_variant -%}
              <fieldset class="variant-options" data-variant-options>
                <legend class="field__label">{{ option_name }}</legend>
                {%- for variant in product.variants -%}
                  <div class="variant-option">
                    <input
                      type="radio"
                      name="variant-choice"
                      id="Variant-{{ section.id }}-{{ variant.id }}"
                      value="{{ variant.id }}"
                      data-variant-input
                      data-price="{{ variant.price | money }}"
                      data-available="{{ variant.available }}"
                      {% if variant.id == current_variant.id %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label class="variant-option__label" for="Variant-{{ section.id }}-{{ variant.id }}">
                      <span>{{ variant.title }}</span>
                      <span class="variant-option__price">
                        {%- if variant.available -%}{{ variant.price | money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                      </span>
                    </label>
                  </div>
                {%- endfor -%}
              </fieldset>
            {%- endunless -%}

            <div class="product-form__actions">
              <div class="quantity" data-quantity>
                <button type="button" data-quantity-step="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">
                  {% render 'icon', name: 'minus' %}
                </button>
                <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric">
                <button type="button" data-quantity-step="1" aria-label="{{ 'products.product.increase_quantity' | t }}">
                  {% render 'icon', name: 'plus' %}
                </button>
              </div>

              <button type="submit" class="button" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>

              <p class="field__error" data-form-error hidden></p>
            </div>
          {%- endform -%}
        </div>

        <p class="product__note" style="margin-top: var(--space-md);">
          {{ settings.tax_note }}
          {%- if settings.shipping_page != blank -%}
            , <a href="{{ settings.shipping_page }}" style="text-decoration: underline;">{{ 'sections.cart.taxes_note' | t }}</a>
          {%- endif -%}
        </p>

        {% render 'vc-scent-profile', product: product %}

        <div style="margin-top: var(--space-2xl);">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'scent_pyramid' -%}
                {%- liquid
                  assign top_notes = product.metafields.custom.kopfnoten.value
                  assign heart_notes = product.metafields.custom.herznoten.value
                  assign base_notes = product.metafields.custom.basisnoten.value
                -%}
                {%- if top_notes != blank or heart_notes != blank or base_notes != blank -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    <h2 class="h4">{{ 'products.product.scent_profile' | t }}</h2>
                    <div class="pyramid">
                      {%- if top_notes != blank -%}
                        <div class="pyramid__row">
                          <span class="pyramid__label meta">{{ 'products.product.top_notes' | t }}</span>
                          <span>{{ top_notes | join: ', ' }}</span>
                        </div>
                      {%- endif -%}
                      {%- if heart_notes != blank -%}
                        <div class="pyramid__row">
                          <span class="pyramid__label meta">{{ 'products.product.heart_notes' | t }}</span>
                          <span>{{ heart_notes | join: ', ' }}</span>
                        </div>
                      {%- endif -%}
                      {%- if base_notes != blank -%}
                        <div class="pyramid__row">
                          <span class="pyramid__label meta">{{ 'products.product.base_notes' | t }}</span>
                          <span>{{ base_notes | join: ', ' }}</span>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'character' -%}
                {%- if character != blank or intensity != blank -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    <h2 class="h4">{{ 'products.product.character' | t }}</h2>
                    <div class="trait-list">
                      {%- for trait in character -%}<span class="trait">{{ trait | escape }}</span>{%- endfor -%}
                      {%- if intensity != blank -%}
                        <span class="trait">{{ 'products.product.intensity' | t }}: {{ intensity | escape }}</span>
                      {%- endif -%}
                      {%- if gender != blank -%}
                        <span class="trait">{{ gender | escape }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'when_to_wear' -%}
                {%- if seasons != blank or occasions != blank -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    <h2 class="h4">{{ 'products.product.when_to_wear' | t }}</h2>
                    <div class="wear-grid">
                      {%- if seasons != blank -%}
                        <div class="wear-grid__item">
                          <p class="meta meta--muted">{{ 'products.product.season' | t }}</p>
                          <p>{{ seasons | join: ' · ' }}</p>
                        </div>
                      {%- endif -%}
                      {%- if occasions != blank -%}
                        <div class="wear-grid__item">
                          <p class="meta meta--muted">{{ 'products.product.occasion' | t }}</p>
                          <p>{{ occasions | join: ' · ' }}</p>
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'concentration_note' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    <div class="concentration-note">
                      <h2 class="h4">{{ block.settings.heading | escape }}</h2>
                      <div class="rte text-body-sm" style="margin-top: var(--space-sm);">{{ block.settings.text }}</div>
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'addons' -%}
                {%- liquid
                  assign sample_variant = null
                  assign travel_variant = null
                  assign sample_keyword = block.settings.sample_keyword | downcase
                  assign travel_keyword = block.settings.travel_keyword | downcase
                  for variant in product.variants
                    assign variant_title_down = variant.title | downcase
                    if sample_keyword != blank and variant_title_down contains sample_keyword
                      assign sample_variant = variant
                    endif
                    if travel_keyword != blank and variant_title_down contains travel_keyword
                      assign travel_variant = variant
                    endif
                  endfor

                  assign show_sample = false
                  if sample_variant and sample_variant.available and sample_variant.id != current_variant.id
                    assign show_sample = true
                  endif
                  assign show_travel = false
                  if travel_variant and travel_variant.available and travel_variant.id != current_variant.id
                    assign show_travel = true
                  endif
                -%}
                {%- if show_sample or show_travel -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    {%- if show_sample -%}
                      <form method="post" action="{{ routes.cart_add_url }}" class="addon">
                        <input type="hidden" name="id" value="{{ sample_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        {%- if product.featured_media -%}
                          <img src="{{ product.featured_media | image_url: width: 160 }}" alt="" width="64" height="80" loading="lazy">
                        {%- endif -%}
                        <div>
                          <p class="addon__title">{{ 'products.product.sample_title' | t }} · {{ sample_variant.title }}</p>
                          <p class="addon__text">{{ 'products.product.sample_help' | t }} {{ sample_variant.price | money }}</p>
                        </div>
                        <button type="submit" class="button button--secondary addon__button">
                          {{ 'products.product.add_sample' | t }}
                        </button>
                      </form>
                    {%- endif -%}

                    {%- if show_travel -%}
                      <form method="post" action="{{ routes.cart_add_url }}" class="addon">
                        <input type="hidden" name="id" value="{{ travel_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        {%- if product.featured_media -%}
                          <img src="{{ product.featured_media | image_url: width: 160 }}" alt="" width="64" height="80" loading="lazy">
                        {%- endif -%}
                        <div>
                          <p class="addon__title">{{ 'products.product.travel_title' | t }} · {{ travel_variant.title }}</p>
                          <p class="addon__text">{{ 'products.product.travel_help' | t }} {{ travel_variant.price | money }}</p>
                        </div>
                        <button type="submit" class="button button--secondary addon__button">
                          {{ 'products.product.add_travel' | t }}
                        </button>
                      </form>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'description' -%}
                {%- assign scent_text = product.metafields.custom.duftbeschreibung.value -%}
                {%- if scent_text != blank or product.description != blank -%}
                  <div class="product-block product__accordion" data-accordion-group {{ block.shopify_attributes }}>
                    <details data-accordion {% if block.settings.open %}open{% endif %}>
                      <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'chevron' %}</summary>
                      <div class="rte">
                        {%- if scent_text != blank -%}{{ scent_text }}{%- else -%}{{ product.description }}{%- endif -%}
                      </div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'ingredients' -%}
                {%- liquid
                  assign inci = product.metafields.custom.inci.value
                  assign allergens = product.metafields.custom.allergene.value
                -%}
                {%- if inci != blank or allergens != blank -%}
                  <div class="product-block product__accordion" data-accordion-group {{ block.shopify_attributes }}>
                    <details data-accordion>
                      <summary>{{ 'products.product.ingredients' | t }} {% render 'icon', name: 'chevron' %}</summary>
                      <div class="rte text-body-sm">
                        {%- if inci != blank -%}<p>{{ inci | newline_to_br }}</p>{%- endif -%}
                        {%- if allergens != blank -%}<p>{{ allergens | newline_to_br }}</p>{%- endif -%}
                      </div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.text != blank -%}
                  <div class="product-block product__accordion" data-accordion-group {{ block.shopify_attributes }}>
                    <details data-accordion>
                      <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'chevron' %}</summary>
                      <div class="rte text-body-sm">{{ block.settings.text }}</div>
                    </details>
                  </div>
                {%- endif -%}

              {%- when 'whatsapp' -%}
                {%- if settings.whatsapp_enabled -%}
                  {%- assign product_code = product.metafields.custom.scent_code.value | default: product.title -%}
                  {%- assign wa_context = 'sections.whatsapp.context_product' | t | replace: '__CODE__', product_code -%}
                  <div class="product-block" {{ block.shopify_attributes }}>
                    <div class="addon">
                      <div style="grid-column: 1 / 3;">
                        <p class="addon__title">{{ block.settings.heading | escape }}</p>
                        <p class="addon__text">{{ block.settings.text | escape }}</p>
                      </div>
                      {% render 'whatsapp-link',
                        class: 'button button--secondary addon__button button--whatsapp',
                        icon: true,
                        context: wa_context,
                        label: block.settings.button_label
                      %}
                    </div>
                  </div>
                {%- endif -%}

              {%- when '@app' -%}
                <div class="product-block" {{ block.shopify_attributes }}>{% render block %}</div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<div class="sticky-atc" data-sticky-atc aria-hidden="true">
  <div class="sticky-atc__info">
    <p class="sticky-atc__title">{{ product.title }}</p>
    <p class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</p>
  </div>
  <button type="button" class="button" data-sticky-add>{{ 'products.product.add_to_cart' | t }}</button>
</div>

<script type="application/json" data-variant-data>
  {
    {%- for variant in product.variants -%}
      {%- capture vd_line -%}{% render 'variant-facts', variant: variant, mode: 'line' %}{%- endcapture -%}
      {%- assign vd_line = vd_line | strip -%}
      {%- liquid
        assign vd_on_sale = false
        assign vd_compare = ''
        if variant.compare_at_price > variant.price
          assign vd_on_sale = true
          assign vd_compare = variant.compare_at_price | money
        endif

        assign vd_unit = ''
        if settings.show_unit_price and variant.unit_price_measurement
          assign vd_unit_amount = variant.unit_price | money
          assign vd_unit = vd_unit_amount | append: ' / '
          if variant.unit_price_measurement.reference_value != 1
            assign vd_unit = vd_unit | append: variant.unit_price_measurement.reference_value
          endif
          assign vd_unit = vd_unit | append: variant.unit_price_measurement.reference_unit
        endif
      -%}
      {{ variant.id | json }}: {
        "price": {{ variant.price | money | json }},
        "compare": {{ vd_compare | json }},
        "onSale": {{ vd_on_sale | json }},
        "unit": {{ vd_unit | json }},
        "sku": {{ variant.sku | json }},
        "available": {{ variant.available | json }},
        "meta": {{ vd_line | json }},
        "media": {{ variant.featured_media.id | default: 0 | json }},
        "title": {{ variant.title | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if is_scent_code_product %}
  {%- comment -%}
    Nur auf dem zentralen Scent-Code-Produkt: liest ?code= aus der Adresszeile,
    füllt Feld, Positionsangabe und Kennzeichnung und sperrt den Button ohne
    gültigen Code. Auf allen anderen Produktseiten wird die Datei nicht geladen.
  {%- endcomment -%}
  <script>
    window.VCCodeOrderStrings = {
      required: {{ 'sections.scent_code.code_required' | t | json }}
    };
  </script>
  <script src="{{ 'scent-code-order.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {% if product.featured_media -%}
  "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif %}
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "sku": {{ variant.sku | json }},
      "name": {{ variant.title | json }},
      "url": {{ shop.url | append: variant.url | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Produkt",
  "tag": "section",
  "settings": [

  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "scent_pyramid",
      "name": "Duftprofil",
      "limit": 1,
      "settings": [

      ]
    },
    {
      "type": "character",
      "name": "Charakter",
      "limit": 1,
      "settings": [

      ]
    },
    {
      "type": "when_to_wear",
      "name": "Jahreszeit und Anlass",
      "limit": 1,
      "settings": [

      ]
    },
    {
      "type": "concentration_note",
      "name": "Konzentrationen erklärt",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Unsere Konzentrationen"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p><strong>Extrait – 30 % Parfumöl.</strong> Die Hauptlinie. Ein hoher Anteil bedeutet, dass der Duft dichter auf der Haut liegt und sich langsamer entwickelt.</p><p><strong>Eau de Parfum – 20 % Parfumöl.</strong> Dasselbe Duftprofil, leichter aufgetragen und unauffälliger im Verlauf.</p><p>Travel und Probe entsprechen der Extrait-Rezeptur, nur in kleinerem Flakon.</p>"
        }
      ]
    },
    {
      "type": "addons",
      "name": "Probe und Travel Size",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "sample_keyword",
          "label": "Erkennungswort für die Probe",
          "default": "sample",
          "info": "Das Theme sucht in den Variantennamen nach diesem Wort."
        },
        {
          "type": "text",
          "id": "travel_keyword",
          "label": "Erkennungswort für Travel",
          "default": "travel"
        }
      ]
    },
    {
      "type": "description",
      "name": "Duftbeschreibung",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Duftbeschreibung"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": true
        }
      ]
    },
    {
      "type": "ingredients",
      "name": "Inhaltsstoffe",
      "limit": 1,
      "settings": [

      ]
    },
    {
      "type": "whatsapp",
      "name": "Duftberatung",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Unsicher, ob dieser Duft passt?"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Schreib uns deinen Lieblingsduft – der Code dieser Seite fährt automatisch mit."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Beschriftung",
          "default": "Duftberatung starten"
        }
      ]
    },
    {
      "type": "text",
      "name": "Freier Textblock",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Hinweise"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
