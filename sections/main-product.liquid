{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id
  assign price_target_id = 'price-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
-%}

<section class="section">
  <div class="page-width">
    <div class="product">
      {%- comment -%} -------- Media gallery -------- {%- endcomment -%}
      <product-gallery class="product__media">
        <div class="product__media-main" data-gallery-main>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- assign media_alt = media.alt | default: product.title | escape -%}
              <div class="media product__media-item" data-media-id="{{ media.id }}" {% unless media.id == featured_media.id %}hidden{% endunless %}>
                {{
                  media.preview_image
                  | image_url: width: 1400
                  | image_tag:
                    widths: '400,600,800,1000,1200,1400',
                    sizes: '(min-width: 990px) 55vw, 100vw',
                    loading: 'eager',
                    alt: media_alt
                }}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="media ratio-square">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media -%}
              <button type="button" class="product__thumb" data-thumb data-media-id="{{ media.id }}" aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}" aria-label="{{ media.alt | default: product.title | escape }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: widths: '80,160', loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </product-gallery>

      {%- comment -%} -------- Product info -------- {%- endcomment -%}
      <div class="product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <span class="card__vendor">{{ product.vendor }}</span>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        <div id="{{ price_target_id }}" class="product__price">
          {% render 'price', product: product, variant: current_variant %}
        </div>

        <product-form>
          {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
            <variant-selector data-form-id="{{ product_form_id }}" data-price-target="{{ price_target_id }}">
              <script type="application/json">
                [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id }},
                      "available": {{ variant.available }},
                      "price": {{ variant.price }},
                      "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                      "options": [
                        {{ variant.option1 | json }}
                        {%- if product.options.size > 1 -%}, {{ variant.option2 | json }}{%- endif -%}
                        {%- if product.options.size > 2 -%}, {{ variant.option3 | json }}{%- endif -%}
                      ],
                      "featured_media": {% if variant.featured_media %}{{ variant.featured_media.id }}{% else %}null{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>

              <input type="hidden" name="id" value="{{ current_variant.id }}">

              {%- unless product.has_only_default_variant -%}
                <div class="variant-options">
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-option">
                      <legend class="variant-option__label">{{ option.name }}</legend>
                      <div class="variant-pills">
                        {%- for value in option.values -%}
                          <label class="variant-pill">
                            <input
                              type="radio"
                              name="option{{ option.position }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}>
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}
            </variant-selector>

            <div class="product-form__buttons">
              <div class="product-form__qty-row">
                <quantity-input class="quantity">
                  <button type="button" data-action="decrease" aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', name: 'minus', size: 16 %}</button>
                  <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" data-action="increase" aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', name: 'plus', size: 16 %}</button>
                </quantity-input>

                <button
                  type="submit"
                  id="AddToCart-{{ section.id }}"
                  class="button button--primary product-form__submit"
                  {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
                  <span class="button__text" data-add="{{ 'products.product.add_to_cart' | t }}">
                    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </span>
                  <span class="loading-spinner"></span>
                </button>
              </div>
              <div class="form-error" data-form-error role="alert" hidden></div>
            </div>
          {%- endform -%}
        </product-form>

        {%- if section.settings.show_fragrance_details -%}
          {% render 'fragrance-details', product: product %}
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="product__description rte">{{ product.description }}</div>
        {%- endif -%}

        {%- if section.settings.show_share -%}
          <div class="product__share">
            <button type="button" class="link-underline" onclick="if(navigator.share){navigator.share({title:document.title,url:location.href})}else{navigator.clipboard.writeText(location.href)}">
              {{ 'products.product.share' | t }}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%} -------- Sticky add-to-cart bar -------- {%- endcomment -%}
{%- if section.settings.enable_sticky_atc -%}
  <sticky-cart class="sticky-atc" data-watch="#AddToCart-{{ section.id }}" data-form-id="{{ product_form_id }}">
    <div class="page-width">
      <div class="sticky-atc__inner">
        <div class="sticky-atc__media">
          {%- if featured_media -%}
            {{ featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          {%- endif -%}
        </div>
        <div class="sticky-atc__info">
          <div class="sticky-atc__title">{{ product.title }}</div>
          <div class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</div>
        </div>
        <button type="button" class="button button--primary sticky-atc__button" data-sticky-add {% unless current_variant.available %}disabled{% endunless %}>
          {{ 'products.product.add_to_cart' | t }}
        </button>
      </div>
    </div>
  </sticky-cart>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share button", "default": true },
    { "type": "checkbox", "id": "show_fragrance_details", "label": "Show fragrance details (metafields)", "default": true },
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Enable sticky add-to-cart bar", "default": true }
  ]
}
{% endschema %}
