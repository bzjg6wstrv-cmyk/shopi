{%- comment -%}
  Cart Drawer. Wird nach jeder Warenkorb-Änderung über die Section Rendering API
  neu gerendert – Warenkorb, Preise und Rabatte bleiben vollständig bei Shopify.
{%- endcomment -%}
<vc-drawer id="CartDrawer" class="drawer drawer--right color-{{ section.settings.color_scheme }} color-scheme" aria-label="{{ 'sections.cart.title' | t }}">
  <div data-cart-section="cart-drawer" style="display: contents;">
    <div class="drawer__header">
      <span class="meta meta--muted">{{ 'sections.cart.title' | t }}</span>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <div class="drawer__body">
      {%- if cart.item_count == 0 -%}
        <div class="stack">
          <p class="h4">{{ 'sections.cart.empty' | t }}</p>
          <p class="text-muted measure-narrow">{{ 'sections.cart.empty_help' | t }}</p>
          {%- if section.settings.empty_link != blank -%}
            <a class="button" href="{{ section.settings.empty_link }}">{{ section.settings.empty_label | escape }}</a>
          {%- endif -%}
          <a class="link-underline" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        {%- if settings.free_shipping_enabled -%}
          {%- liquid
            assign threshold_major = settings.free_shipping_threshold | times: 1
            assign threshold_cents = threshold_major | times: 100
            assign remaining = threshold_cents | minus: cart.total_price
            assign remaining_money = remaining | money
            assign progress = 0
            if threshold_cents > 0
              assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
              if progress > 100
                assign progress = 100
              endif
            endif
          -%}
          <div class="shipping-bar" data-shipping-bar>
            <p class="meta meta--muted">
              {%- if remaining > 0 -%}
                {{ 'sections.cart.free_shipping_progress' | t: amount: remaining_money }}
              {%- else -%}
                {{ 'sections.cart.free_shipping_reached' | t }}
              {%- endif -%}
            </p>
            <div class="shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
              <div class="shipping-bar__fill" style="width: {{ progress }}%;"></div>
            </div>
            <p class="text-muted" style="font-size: .6875rem;">{{ 'sections.cart.free_shipping_disclaimer' | t }}</p>
          </div>
        {%- endif -%}

        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item" data-cart-item data-line="{{ forloop.index }}">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    alt=""
                    width="72"
                    height="96"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div>
                <p class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>

                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}

                {%- if item.unit_price_measurement -%}
                  <p class="cart-item__variant">
                    {{ item.unit_price | money }} {{ 'general.accessibility.unit_price_separator' | t }}
                    {%- if item.unit_price_measurement.reference_value != 1 %} {{ item.unit_price_measurement.reference_value }}{% endif %}
                    {{ item.unit_price_measurement.reference_unit }}
                  </p>
                {%- endif -%}

                {%- assign visible_properties = false -%}
                {%- for property in item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}
                    {%- assign visible_properties = true -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if visible_properties -%}
                  {%- assign code_label = 'sections.scent_code.code_in_order' | t -%}
                  <dl class="cart-item__properties">
                    {%- for property in item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- if property.last != blank and first_char != '_' -%}
                        {%- assign is_code = false -%}
                        {%- if property.first contains code_label -%}{%- assign is_code = true -%}{%- endif -%}
                        <div{% if is_code %} class="cart-item__code"{% endif %}>
                          <dt>{{ property.first | escape }}:</dt>
                          <dd>{{ property.last | escape }}</dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </dl>
                {%- endif -%}

                {%- if item.line_level_discount_allocations.size > 0 -%}
                  <ul class="cart-item__properties">
                    {%- for allocation in item.line_level_discount_allocations -%}
                      <li>{{ allocation.discount_application.title }} (−{{ allocation.amount | money }})</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <div class="cart-item__row">
                  <div class="quantity" data-quantity>
                    <button type="button" data-quantity-step="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">
                      {% render 'icon', name: 'minus' %}
                    </button>
                    <label class="visually-hidden" for="CartQty-{{ forloop.index }}">{{ 'products.product.quantity' | t }}</label>
                    <input
                      id="CartQty-{{ forloop.index }}"
                      type="number"
                      min="0"
                      step="1"
                      value="{{ item.quantity }}"
                      data-cart-quantity
                      data-line="{{ forloop.index }}"
                      inputmode="numeric"
                    >
                    <button type="button" data-quantity-step="1" aria-label="{{ 'products.product.increase_quantity' | t }}">
                      {% render 'icon', name: 'plus' %}
                    </button>
                  </div>
                  <span class="cart-item__price">{{ item.final_line_price | money }}</span>
                </div>

                <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- liquid
          assign cross_sell = settings.cart_cross_sell_product
          assign show_cross_sell = false
          if settings.cart_cross_sell_enabled and cross_sell != blank
            assign show_cross_sell = true
            for item in cart.items
              if item.product.id == cross_sell.id
                assign show_cross_sell = false
              endif
            endfor
          endif
        -%}
        {%- if show_cross_sell -%}
          <div class="cart-cross-sell">
            <p class="meta meta--muted">{{ 'sections.cart.cross_sell_title' | t }}</p>
            <a class="cart-cross-sell__item" href="{{ cross_sell.url }}">
              {%- if cross_sell.featured_media -%}
                <img src="{{ cross_sell.featured_media | image_url: width: 120 }}" alt="" width="56" height="72" loading="lazy">
              {%- endif -%}
              <span>
                <span class="cart-item__title">{{ cross_sell.title }}</span>
                <span class="cart-item__variant">{{ cross_sell.price | money }}</span>
              </span>
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__footer cart-footer">
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          {%- if settings.cart_show_note -%}
            <div class="field cart-note">
              <label class="field__label" for="CartNote">{{ 'sections.cart.note' | t }}</label>
              <textarea class="field__input" id="CartNote" name="note" rows="2">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}

          <div class="cart-footer__row">
            <span class="meta meta--muted">{{ 'sections.cart.subtotal' | t }}</span>
            <span class="cart-footer__total">{{ cart.total_price | money }}</span>
          </div>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-footer__row">
                <span class="text-muted text-body-sm">{{ discount.title }}</span>
                <span class="text-muted text-body-sm">−{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <p class="text-muted" style="font-size: .75rem;">
            {{ settings.tax_note }}
            {%- if settings.shipping_page != blank -%}
              , <a href="{{ settings.shipping_page }}" style="text-decoration: underline;">{{ 'sections.cart.taxes_note' | t }}</a>
            {%- else -%}
              . {{ 'sections.cart.taxes_note' | t }}
            {%- endif -%}
          </p>

          <button type="submit" name="checkout" class="button">{{ 'sections.cart.checkout' | t }}</button>
          <a class="link-underline" style="display:block;margin-top:var(--space-md);text-align:center;" href="{{ routes.cart_url }}">
            {{ 'sections.cart.view_cart' | t }}
          </a>
        </form>
      </div>
    {%- endif -%}
  </div>
</vc-drawer>

<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Warenkorb-Drawer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Button im leeren Warenkorb",
      "default": "Discovery Set ansehen"
    },
    {
      "type": "url",
      "id": "empty_link",
      "label": "Link des Buttons"
    }
  ]
}
{% endschema %}
