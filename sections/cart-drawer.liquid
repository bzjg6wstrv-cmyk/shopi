<cart-drawer class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="cart-drawer__header">
      <h2>{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer__close" data-cart-close type="button" aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </div>
    <div id="CartDrawerContents" data-item-count="{{ cart.item_count }}">
      {% render 'cart-drawer-contents' %}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
