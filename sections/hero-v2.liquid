{{ 'section-hero-v2.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Hero V2 – redaktionelle Komposition.

  Aufbau: Links eine schmale Textspalte auf fester Rasterkante, rechts ein
  angeschnittenes Bild, das bis an den rechten Bildschirmrand läuft. Die
  beiden Wege in den Shop stehen unter einer Haarlinie nebeneinander und
  sind dadurch klar unterscheidbar:
    Weg A – Beratung per WhatsApp, für alle ohne Code
    Weg B – Scent-Code-Eingabe, für alle, die bereits beraten wurden

  Auf dem Telefon steht die Schlagzeile zuerst, direkt danach der
  Beratungsweg und die Code-Eingabe. Das Bild folgt erst darunter.

  Ohne hinterlegtes Bild wird der Abschnitt bewusst rein typografisch – es
  erscheint kein heller Platzhalter als leere Fläche.
{%- endcomment -%}
<section class="hero2{% if section.settings.image == blank %} hero2--no-image{% endif %} color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width hero2__inner">
    <div class="hero2__body">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero2__eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- assign heading_lines = section.settings.heading | strip | newline_to_br | split: '<br />' -%}
        <h1 class="hero2__title display display--lines">
          {%- for line in heading_lines -%}
            {%- assign line_text = line | strip -%}
            {%- if line_text != blank -%}
              <span class="display__line reveal" data-reveal-delay="{{ forloop.index0 }}">{{ line_text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hero2__text reveal" data-reveal-delay="3">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      <div class="hero2__paths reveal" data-reveal-delay="4">
        {%- if section.settings.show_whatsapp -%}
          <div class="hero2__path hero2__path--advice">
            {%- if section.settings.whatsapp_hint != blank -%}
              <span class="hero2__hint">{{ section.settings.whatsapp_hint | escape }}</span>
            {%- endif -%}
            {% render 'whatsapp-link', class: 'button hero2__cta', icon: true %}
          </div>
        {%- endif -%}

        {%- if section.settings.show_code_field -%}
          <div class="hero2__path hero2__path--code">
            <div class="hero2__code">
              {% render 'scent-code-field',
                id: 'HeroScentCode',
                size: 'inline',
                label: section.settings.code_label
              %}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <p class="hero2__secondary reveal" data-reveal-delay="4">
          <a class="link-underline" href="{{ section.settings.secondary_link }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="hero2__media">
        <div class="hero2__media-inner" data-hero-drift>
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 900 }} 900w,
                    {{ section.settings.image | image_url: width: 1400 }} 1400w,
                    {{ section.settings.image | image_url: width: 1800 }} 1800w"
            sizes="(min-width: 990px) 52vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero V2",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleiner Vortext",
      "default": "Über 120 Duftprofile"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Schlagzeile",
      "default": "FIND\nYOUR\nSCENT.",
      "info": "Eine Zeile pro Umbruch. Die Zeilen blenden nacheinander ein."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Unterzeile",
      "default": "Dein Lieblingsduft. Dein VENT CELESTE Scent Code."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Hochformat, mindestens 1400 px breit. Ohne Bild wird der Hero bewusst rein typografisch dargestellt – es erscheint kein Platzhalter."
    },
    {
      "type": "header",
      "content": "Aktionen"
    },
    {
      "type": "text",
      "id": "whatsapp_hint",
      "label": "Kleine Zeile über dem Beratungsbutton",
      "info": "Weg B – für alle ohne Code. Leer lassen blendet die Zeile aus.",
      "default": "Noch keinen Code?"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "WhatsApp-Beratung anbieten",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundärer Button"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link sekundärer Button"
    },
    {
      "type": "header",
      "content": "Scent Code"
    },
    {
      "type": "checkbox",
      "id": "show_code_field",
      "label": "Code-Eingabe im Hero anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Beschriftung",
      "default": "Schon beraten? Scent Code eingeben"
    }
  ],
  "presets": [
    {
      "name": "Hero V2"
    }
  ]
}
{% endschema %}
