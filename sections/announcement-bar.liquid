{%- comment -%}
  Ankündigungsleiste. Bewusst statisch und ohne Countdown oder Blinken.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement color-{{ section.settings.color_scheme }} color-scheme">
    <div class="page-width announcement__inner">
      {%- for block in section.blocks limit: 1 -%}
        <p class="announcement__text" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Ankündigungsleiste",
  "class": "announcement-section",
  "max_blocks": 1,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Ankündigung",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Versand innerhalb Deutschlands"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ankündigungsleiste",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
