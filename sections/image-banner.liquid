<section class="section section--tight">
  <div class="page-width">
    <div class="hero{% if section.settings.text_color == 'dark' %} hero--text-dark{% endif %}" style="min-height:{{ section.settings.height }}px;">
      {%- if section.settings.image != blank -%}
        {%- assign banner_alt = section.settings.heading | escape -%}
        <div class="hero__media">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '600,900,1200,1600,2000,2400',
              sizes: '100vw',
              loading: 'eager',
              alt: banner_alt
          }}
        </div>
        {%- if section.settings.text_color != 'dark' -%}<div class="hero__overlay"></div>{%- endif -%}
      {%- endif -%}

      <div class="hero__content reveal">
        {%- if section.settings.subheading != blank -%}
          <p style="text-transform:uppercase;letter-spacing:0.1em;font-size:0.85rem;opacity:0.9;margin-bottom:0.5rem;">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "min": 300, "max": 800, "step": 20, "unit": "px", "label": "Height", "default": 520 },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed for modern living" },
    { "type": "text", "id": "text", "label": "Text", "default": "Discover pieces made to last." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "text_color", "label": "Text color",
      "options": [ { "value": "light", "label": "Light (on photo)" }, { "value": "dark", "label": "Dark" } ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
