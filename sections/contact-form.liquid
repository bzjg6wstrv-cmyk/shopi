{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Kontaktformular über den nativen Shopify-Form-Tag.
  Nachrichten laufen an die im Shopify-Admin hinterlegte Shop-E-Mail.
{%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width page-width--narrow">
    <h2 class="h3">{{ section.settings.heading | escape }}</h2>

    {%- form 'contact', class: 'stack-lg', style: 'max-width: 34rem; margin-top: var(--space-xl);' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status" role="status">{{ 'templates.contact.form.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="field__error" role="alert">{{ 'templates.contact.form.error' | t }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ContactName">{{ 'templates.contact.form.name' | t }}</label>
        <input class="field__input" id="ContactName" type="text" name="contact[Name]" autocomplete="name">
      </div>
      <div class="field">
        <label class="field__label" for="ContactEmail">{{ 'templates.contact.form.email' | t }}</label>
        <input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="ContactSubject">{{ 'templates.contact.form.subject' | t }}</label>
        <input class="field__input" id="ContactSubject" type="text" name="contact[Betreff]">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'templates.contact.form.message' | t }}</label>
        <textarea class="field__input" id="ContactBody" name="contact[body]" rows="6" required></textarea>
      </div>
      <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}

    {%- if section.settings.show_company_data -%}
      <div style="margin-top: var(--space-2xl);">
        <p class="meta meta--muted">{{ section.settings.company_heading | escape }}</p>
        <ul class="footer__list text-muted" style="margin-top: var(--space-sm);">
          <li>{{ settings.company_name }}</li>
          <li>{{ settings.company_address }}</li>
          <li>USt-IdNr.: {{ settings.company_vat }}</li>
          <li>{{ settings.contact_email }}</li>
          <li>{{ settings.contact_phone }}</li>
          <li>{{ settings.contact_hours }}</li>
        </ul>
        <p class="demo-flag" style="margin-top: var(--space-md);">{{ 'general.demo_notice' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kontaktformular",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Kontakt"
    },
    {
      "type": "checkbox",
      "id": "show_company_data",
      "label": "Firmendaten anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Überschrift Firmendaten",
      "default": "Anbieter"
    }
  ],
  "presets": [
    {
      "name": "Kontaktformular"
    }
  ]
}
{% endschema %}
