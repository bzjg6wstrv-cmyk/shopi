<section class="section">
  <div class="page-width">
    <div class="newsletter reveal">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="section-header__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p style="width:100%;">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-label="{{ 'general.newsletter.email' | t }}">
          <button type="submit" class="button button--primary">{{ 'general.newsletter.subscribe' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the club" },
    { "type": "text", "id": "text", "label": "Text", "default": "Be the first to know about new arrivals and exclusive offers." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
