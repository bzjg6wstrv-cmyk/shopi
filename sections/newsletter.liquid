{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Newsletter – bewusst als ruhiger Abschnitt im Seitenfluss.
  Kein Pop-up, keine Verzögerung, keine Rabattversprechen.

  Der Abschnitt ist absichtlich flach gehalten: links die Anrede, rechts
  eine einzige Eingabezeile auf einer Haarlinie. Kein Formularkasten und
  keine große Fläche vor dem Fußbereich.
{%- endcomment -%}
<section class="section section--tight color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    <div class="newsletter reveal">
      <div class="newsletter__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="h3 newsletter__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="newsletter__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="newsletter__action">
        {%- form 'customer', class: 'newsletter__form', id: 'NewsletterSection' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="inline-field">
            <label class="visually-hidden" for="NewsletterSectionEmail">{{ 'general.newsletter.label' | t }}</label>
            <input
              class="field__input"
              id="NewsletterSectionEmail"
              type="email"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="inline-field__submit">{{ 'general.newsletter.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="field__error newsletter__status">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- elsif form.posted_successfully? -%}
            <p class="form-status newsletter__status">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}

        <p class="newsletter__note">{{ 'general.newsletter.privacy_note' | t }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleiner Vortext",
      "default": "Auf dem Laufenden bleiben"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Neue Duftprofile"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Wir schreiben selten und nur, wenn es etwas zu berichten gibt."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
