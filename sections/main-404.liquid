<section class="section">
  <div class="page-width">
    <div class="error-page">
      <span class="eyebrow">404</span>
      <h1 class="h2">{{ 'templates.404.title' | t }}</h1>
      <p class="error-page__text">{{ 'templates.404.subtext' | t }}</p>
      <div class="error-page__actions">
        <a class="button" href="{{ routes.root_url }}">{{ 'templates.404.link' | t }}</a>
        <a class="link-underline" href="{{ routes.search_url }}">{{ 'general.search.title' | t }}</a>
      </div>
    </div>
  </div>
</section>

