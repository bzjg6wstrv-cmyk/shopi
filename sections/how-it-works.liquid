{{ 'section-scent-code.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Ablauf in drei Schritten. Bewusst als nummerierte Zeilenliste –
  keine drei gleichförmigen Karten nebeneinander.
{%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2" style="margin-bottom: var(--space-2xl);">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="steps__item reveal" data-reveal-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="steps__number" aria-hidden="true"></span>
          <span class="steps__title">{{ block.settings.title | escape }}</span>
          <span class="steps__text">{{ block.settings.text | escape }}</span>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.show_whatsapp -%}
      <div style="margin-top: var(--space-2xl);">
        {% render 'whatsapp-link', class: 'button button--whatsapp', icon: true %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "So funktioniert's",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "So funktioniert's"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "WhatsApp-Button darunter",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Lieblingsduft nennen"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Schreib uns per WhatsApp, welches Parfum du magst."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "So funktioniert's",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
