{{ 'section-scent-code.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Ablauf in drei Schritten. Bewusst als nummerierte Zeilenliste mit feinen
  Trennlinien – keine Karten, keine Rahmen, keine Symbole je Schritt.
  Ziffer links, Titel und Beschreibung rechts. Der Beratungsweg steht am
  Ende der Liste auf derselben Textkante wie die Titel.
{%- endcomment -%}
<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head">
        <h2 class="h2 sec-head__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}
          <p class="sec-head__aside">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="steps reveal">
      {%- for block in section.blocks -%}
        <li class="steps__item" {{ block.shopify_attributes }}>
          <span class="steps__number" aria-hidden="true"></span>
          <div class="steps__body">
            <h3 class="steps__title">{{ block.settings.title | escape }}</h3>
            <p class="steps__text">{{ block.settings.text | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.show_whatsapp -%}
      <div class="steps__cta">
        {% render 'whatsapp-link', class: 'button steps__button', icon: true %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "So funktioniert's",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "So funktioniert's"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Beitext rechts neben der Überschrift",
      "info": "Ein kurzer Satz. Leer lassen blendet ihn aus.",
      "default": "Von der Beratung bis zur Bestellung in drei Schritten."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "WhatsApp-Button darunter",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Lieblingsduft nennen"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Schreib uns deinen Lieblingsduft per WhatsApp."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "So funktioniert's",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
