{%- comment -%}
  Collection – Basisausbau (Ausbaustufe 1): Raster, Sortierung, Paginierung.
  Die vollständige Filterleiste mit Duftfamilie, Charakter, Intensität,
  Jahreszeit, Anlass, Geschlecht und Preis folgt in Ausbaustufe 2
  (Shopify Search & Discovery, siehe README).
{%- endcomment -%}
{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="section">
    <div class="page-width">
      <div class="collection-head">
        <h1 class="h2">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <div class="rte text-muted measure">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      <div class="collection-toolbar">
        <p class="meta meta--muted">
          {{ 'products.facets.product_count' | t: count: collection.products_count }}
        </p>

        <form method="get" data-sort-form>
          <label class="visually-hidden" for="SortBy">{{ 'products.facets.sort_by' | t }}</label>
          <select id="SortBy" name="sort_by" class="field__input" style="min-height:2.75rem;">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="button button--quiet">{{ 'products.facets.apply' | t }}</button></noscript>
        </form>
      </div>

      {%- if collection.products.size == 0 -%}
        <p class="note-placeholder">{{ 'products.facets.no_results' | t }}</p>
      {%- else -%}
        <ul class="grid grid--products">
          {%- for product in collection.products -%}
            <li>
              {% render 'product-card', product: product, lazy: 'lazy' %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

<script>
  document.querySelector('[data-sort-form] select')?.addEventListener('change', function (event) {
    var url = new URL(window.location.href);
    url.searchParams.set('sort_by', event.target.value);
    url.searchParams.delete('page');
    window.location.href = url.toString();
  });
</script>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "label": "Produkte pro Seite",
      "default": 24
    }
  ]
}
{% endschema %}
