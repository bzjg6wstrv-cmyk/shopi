{%- paginate blog.articles by 12 -%}
  <section class="section">
    <div class="page-width">
      <h1 class="h2 mb-2xl">{{ blog.title }}</h1>
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <article class="card">
            {%- if article.image -%}
              <div class="card__media card__media--square">
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}"
                     width="{{ article.image.width }}" height="{{ article.image.height }}" loading="lazy">
              </div>
            {%- endif -%}
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__family">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
