<section class="section">
  <div class="page-width">
    <div class="section-header reveal"><h1>{{ blog.title }}</h1></div>

    {%- paginate blog.articles by 12 -%}
      <ul class="product-grid" style="--cols:3;">
        {%- for article in blog.articles -%}
          <li>
            <a class="card reveal" href="{{ article.url }}">
              {%- if article.image -%}
                {%- assign article_alt = article.title | escape -%}
                <div class="card__media media ratio-landscape">
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article_alt }}
                </div>
              {%- endif -%}
              <div class="card__info">
                <span class="card__vendor">{{ article.published_at | date: '%B %-d, %Y' }}</span>
                <h3 class="card__title">{{ article.title }}</h3>
                {%- if article.excerpt_or_content != blank -%}
                  <p style="color:rgba(var(--color-text-rgb),0.7);">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
