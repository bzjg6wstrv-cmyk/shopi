<section class="section">
  <div class="page-width">
    <div class="section-header reveal">
      <h1>
        {%- if search.performed -%}{{ 'general.search.results_for' | t: terms: search.terms }}{%- else -%}{{ 'general.search.search' | t }}{%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:520px;margin:1rem auto 0;display:flex;gap:0.5rem;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.search' | t }}">
        <input type="hidden" name="type" value="product">
        <button class="button button--primary" type="submit">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        {%- paginate search.results by 16 -%}
          <ul class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <li>{% render 'card-product', product: item %}</li>
              {%- else -%}
                <li>
                  <a class="card reveal" href="{{ item.url }}">
                    <div class="card__info">
                      <span class="card__vendor">{{ item.object_type }}</span>
                      <h3 class="card__title">{{ item.title }}</h3>
                    </div>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="empty-state">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
