{%- paginate search.results by 24 -%}
  <section class="section">
    <div class="page-width">
      <div class="collection-head">
        <h1 class="h2">
          {%- if search.performed -%}
            {{ 'general.search.results_for' | t: terms: search.terms }}
          {%- else -%}
            {{ 'general.search.title' | t }}
          {%- endif -%}
        </h1>

        <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form" style="max-width: 40rem;">
          <label class="visually-hidden" for="SearchPageInput">{{ 'general.search.title' | t }}</label>
          <input
            id="SearchPageInput"
            class="search-panel__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ settings.search_placeholder | escape }}"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="button button--quiet">{{ 'general.search.submit' | t }}</button>
        </form>
      </div>

      {%- if search.performed -%}
        {% render 'scent-code-hit', terms: search.terms %}

        {%- if search.results.size == 0 -%}
          <div class="note-placeholder">
            <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
            <p>{{ 'general.search.no_results_help' | t }}</p>
            {%- if settings.whatsapp_enabled -%}
              {%- assign wa_context = 'sections.whatsapp.context_search' | t | replace: '__CODE__', search.terms -%}
              <p style="margin-top: var(--space-lg);">
                {% render 'whatsapp-link', class: 'button button--whatsapp', icon: true, context: wa_context %}
              </p>
            {%- endif -%}
          </div>
        {%- else -%}
          <p class="meta meta--muted" style="margin-bottom: var(--space-lg);">
            {{ 'general.search.results_count' | t: count: search.results_count }}
          </p>
          <ul class="grid grid--products">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item, lazy: 'lazy' %}
                {%- else -%}
                  <article class="card">
                    <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                    <p class="card__family">{{ item.content | default: item.excerpt | strip_html | truncate: 120 }}</p>
                  </article>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Suche",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
