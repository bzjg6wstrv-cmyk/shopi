{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Wiederverwendbarer Editorial-Abschnitt: Bild plus Text.

  Zwei ausdrücklich verschiedene Kompositionen, damit zwei Abschnitte
  hintereinander nie wie dieselbe Vorlage zweimal wirken:

    „spec"      – produktnah und präzise. Hochformatiges Bild links, Text
                  rechts, die Merkmale als exakte Angabenliste mit
                  Haarlinien und rechtsbündigen Werten.
    „statement" – markenorientiert. Breites Bild, das rechts aus dem
                  Innenabstand herausläuft, daneben eine schmale Textspalte
                  auf einer Haarlinie, größerer Schriftgrad, kein
                  Angabenblock, kein gefüllter Button.
    „monument"  – ein einzelner Wert wird selbst zum Gestaltungselement.
                  Die Angabe aus dem Feld „Große Zahl" steht sehr groß und
                  sehr zurückgenommen hinter der Komposition, das Bild sitzt
                  versetzt darüber.

  Preise stammen bei Bedarf aus einem echten Shopify-Produkt.
{%- endcomment -%}
{%- liquid
  assign linked_product = section.settings.product
  assign feature_variant = linked_product.metafields.custom.hauptvariante.value
  if feature_variant == blank
    assign feature_variant = linked_product.selected_or_first_available_variant
  endif
-%}
<section class="section section--lg color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    <div class="feature feature--{{ section.settings.layout | default: 'spec' }}{% if section.settings.media_position == 'right' %} feature--reverse{% endif %}{% if section.settings.media_shape == 'tall' %} feature--narrow-media{% endif %} reveal">

      <div class="feature__media feature__media--{{ section.settings.media_shape }}">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                    {{ section.settings.image | image_url: width: 900 }} 900w,
                    {{ section.settings.image | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'full-bleed-media' }}
        {%- endif -%}
      </div>

      <div class="feature__body">
        {%- comment -%}
          Die große Zahl liegt hinter dem Textblock, nicht hinter dem
          Abschnitt: Auf dem Telefon steht das Bild zuerst, dort wäre sie
          sonst verdeckt.
        {%- endcomment -%}
        {%- if section.settings.layout == 'monument' and section.settings.figure != blank -%}
          <span class="feature__figure" aria-hidden="true">{{ section.settings.figure | escape }}</span>
        {%- endif -%}

        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte feature__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="feature__points">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="meta">{{ block.settings.label | escape }}</span>
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if linked_product != blank and section.settings.show_price -%}
          <div class="feature__price">
            {% render 'product-price', variant: feature_variant, product: linked_product %}
          </div>
        {%- endif -%}

        {%- if section.settings.placeholder_note -%}
          <p class="demo-flag feature__note">{{ 'general.demo_notice' | t }}</p>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="feature__actions">
            {%- if section.settings.primary_label != blank -%}
              {%- if section.settings.layout == 'statement' -%}
                <a class="link-underline" href="{{ section.settings.primary_link | default: linked_product.url }}">
                  {{ section.settings.primary_label | escape }}
                </a>
              {%- else -%}
                <a class="button" href="{{ section.settings.primary_link | default: linked_product.url }}">
                  {{ section.settings.primary_label | escape }}
                </a>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.secondary_label != blank -%}
              <a class="link-underline" href="{{ section.settings.secondary_link }}">
                {{ section.settings.secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial-Abschnitt",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Farbstil",
      "options": [
        { "value": "scheme-1", "label": "Ivory" },
        { "value": "scheme-2", "label": "Ivory dunkel" },
        { "value": "scheme-3", "label": "Schwarz" },
        { "value": "scheme-4", "label": "Taupe" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Komposition",
      "options": [
        { "value": "spec", "label": "Produktnah – Bild hochformatig, Angaben rechts" },
        { "value": "statement", "label": "Markenauftritt – breites Bild, schmale Textspalte" },
        { "value": "monument", "label": "Monument – große Zahl als Gestaltungselement" }
      ],
      "default": "spec",
      "info": "Der Markenauftritt setzt Bildseite und Bildformat selbst; Position und Format unten wirken dann nicht."
    },
    {
      "type": "text",
      "id": "figure",
      "label": "Große Zahl",
      "info": "Nur für die Komposition Monument. Kurz halten, zum Beispiel 30 %."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Bildposition",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "right",
          "label": "Rechts"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_shape",
      "label": "Bildformat",
      "options": [
        {
          "value": "wide",
          "label": "Breit 4:3"
        },
        {
          "value": "tall",
          "label": "Hoch 4:5"
        }
      ],
      "default": "wide"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleiner Vortext"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Produktbezug"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Verknüpftes Produkt",
      "info": "Optional. Der Preis wird direkt aus Shopify gelesen, nicht im Theme hinterlegt."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Preis anzeigen",
      "default": false
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primärer Button"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Link primärer Button"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundärer Button"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link sekundärer Button"
    },
    {
      "type": "header",
      "content": "Hinweis"
    },
    {
      "type": "checkbox",
      "id": "placeholder_note",
      "label": "Als Platzhaltertext kennzeichnen",
      "default": false,
      "info": "Für Abschnitte mit Mustertext, etwa „Über VENT CELESTE“."
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Detailzeile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Bezeichnung",
          "default": "Konzentration"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Wert",
          "default": "30 % Extrait"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial-Abschnitt"
    }
  ]
}
{% endschema %}
