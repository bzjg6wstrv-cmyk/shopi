{{ 'section-scent-code.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Generischer Bestellweg für Scent Codes ohne eigene Produktseite.

  Der eingegebene Code wird als Positionsangabe (line item property) an das
  native Shopify-Produktformular gehängt. Damit steht er im Warenkorb, im
  Checkout, in der Bestellbestätigung, im Admin, auf dem Lieferschein und in
  jedem Bestell-Export. Es gibt keinen zweiten Datenspeicher.

  Bewusst ohne Product-Schema (JSON-LD): Ein Artikel mit Preisspanne und ohne
  konkretes Duftprofil wäre für Suchmaschinen irreführend.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign prefix = settings.scent_code_prefix | default: 'VC'
-%}
<section class="section">
  <div class="page-width">
    <div class="code-order">
      <div class="code-order__intro">
        {%- if product.featured_media -%}
          <img
            src="{{ product.featured_media | image_url: width: 1000 }}"
            srcset="{{ product.featured_media | image_url: width: 500 }} 500w,
                    {{ product.featured_media | image_url: width: 1000 }} 1000w"
            sizes="(min-width: 990px) 38vw, 100vw"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="{{ product.featured_media.width }}"
            height="{{ product.featured_media.height }}"
            loading="eager"
            fetchpriority="high"
            class="code-page__image"
          >
        {%- endif -%}

        <h1 class="h2 mt-lg">{{ product.title }}</h1>

        {%- if product.description != blank -%}
          <div class="rte measure mt-md">{{ product.description }}</div>
        {%- endif -%}

        {%- if settings.whatsapp_enabled -%}
          <p class="code-order__note">
            {{ 'sections.scent_code.no_code_yet' | t }}
            {% render 'whatsapp-link', class: 'link-underline', label: section.settings.whatsapp_label %}
          </p>
        {%- endif -%}
      </div>

      <div>
        <p class="eyebrow">{{ 'sections.scent_code.your_code' | t }}</p>

        <div class="code-order__field">
          {% render 'scent-code-field', id: 'OrderScentCode', size: 'large', mode: 'local', submit: section.settings.check_label %}
        </div>

        <form method="post" action="{{ routes.cart_add_url }}" id="ScentCodeOrderForm" data-scent-code-order>
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[{{ 'sections.scent_code.code_in_order' | t }}]" value="" data-code-property>
          <input type="hidden" name="properties[_vc_code]" value="" data-code-property-hidden>

          <p class="code-order__badge" data-code-badge hidden>
            <span data-code-badge-value>{{ prefix }}-000</span>
          </p>

          {%- unless product.has_only_default_variant -%}
            <fieldset class="variant-options" data-variant-options>
              <legend class="field__label">{{ product.options_with_values.first.name | escape }}</legend>
              {%- for variant in product.variants -%}
                <div class="variant-option">
                  <input
                    type="radio"
                    name="variant-choice"
                    id="CodeVariant-{{ variant.id }}"
                    value="{{ variant.id }}"
                    data-variant-input
                    data-price="{{ variant.price | money }}"
                    data-available="{{ variant.available }}"
                    {% if variant.id == current_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <label class="variant-option__label" for="CodeVariant-{{ variant.id }}">
                    <span>{{ variant.title }}</span>
                    <span class="variant-option__price">
                      {%- if variant.available -%}{{ variant.price | money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                    </span>
                  </label>
                </div>
              {%- endfor -%}
            </fieldset>
          {%- endunless -%}

          {%- capture code_variant_line -%}{% render 'variant-facts', variant: current_variant, mode: 'line' %}{%- endcapture -%}
          {%- assign code_variant_line = code_variant_line | strip -%}
          <p class="meta meta--muted" data-variant-meta{% if code_variant_line == blank %} hidden{% endif %}>
            {{ code_variant_line }}
          </p>

          <div class="product__price" data-product-price>
            {% render 'product-price', variant: current_variant, product: product %}
          </div>

          <p class="product__note" data-variant-sku{% if current_variant.sku == blank %} hidden{% endif %}>
            {{ 'products.product.sku' | t }}: <span data-variant-sku-value>{{ current_variant.sku }}</span>
          </p>

          <div class="product-form__actions">
            <button type="submit" class="button" data-code-submit disabled>
              {{ 'products.product.add_to_cart' | t }}
            </button>
            <p class="field__error" data-form-error hidden></p>
          </div>
        </form>

        <p class="product__note mt-md">
          {{ settings.tax_note }}
          {%- if settings.shipping_page != blank -%}
            , <a class="link-inline" href="{{ settings.shipping_page }}">{{ 'sections.cart.taxes_note' | t }}</a>
          {%- endif -%}
        </p>

        {%- if section.settings.note != blank -%}
          <div class="code-order__note rte">{{ section.settings.note }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-variant-data>
  {
    {%- for variant in product.variants -%}
      {%- capture vd_line -%}{% render 'variant-facts', variant: variant, mode: 'line' %}{%- endcapture -%}
      {%- assign vd_line = vd_line | strip -%}
      {%- liquid
        assign vd_on_sale = false
        assign vd_compare = ''
        if variant.compare_at_price > variant.price
          assign vd_on_sale = true
          assign vd_compare = variant.compare_at_price | money
        endif

        assign vd_unit = ''
        if settings.show_unit_price and variant.unit_price_measurement
          assign vd_unit_amount = variant.unit_price | money
          assign vd_unit = vd_unit_amount | append: ' / '
          if variant.unit_price_measurement.reference_value != 1
            assign vd_unit = vd_unit | append: variant.unit_price_measurement.reference_value
          endif
          assign vd_unit = vd_unit | append: variant.unit_price_measurement.reference_unit
        endif
      -%}
      {%- comment -%}
        Schlüssel in Anführungszeichen – siehe main-product.liquid: eine
        Zahl als unquotierter Objektschlüssel ergibt kein gültiges JSON.
      {%- endcomment -%}
      "{{ variant.id }}": {
        "price": {{ variant.price | money | json }},
        "compare": {{ vd_compare | json }},
        "onSale": {{ vd_on_sale | json }},
        "unit": {{ vd_unit | json }},
        "sku": {{ variant.sku | json }},
        "available": {{ variant.available | json }},
        "meta": {{ vd_line | json }},
        "title": {{ variant.title | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  }
</script>
<script>
  window.VCCodeOrderStrings = {
    required: {{ 'sections.scent_code.code_required' | t | json }}
  };
</script>
<script src="{{ 'scent-code-order.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Scent Code bestellen",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "check_label",
      "label": "Beschriftung Prüf-Button",
      "default": "Prüfen"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Textlink zur Beratung",
      "default": "Duftberatung starten"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Hinweis unter dem Formular",
      "default": "<p>Dein Scent Code wird mit der Bestellung übermittelt und erscheint auf der Bestellbestätigung.</p>"
    }
  ]
}
{% endschema %}
