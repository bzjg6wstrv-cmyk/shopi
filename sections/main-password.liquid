<section class="section">
  <div class="page-width page-width--narrow text-center">
    <h1 class="header__logo" style="font-size:2rem;">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="rte" style="margin-block:1rem;">{{ shop.password_message }}</div>
    {%- endif -%}
    <h2 style="margin-top:1.5rem;">{{ section.settings.heading }}</h2>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:var(--color-sale);">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div style="display:flex;gap:0.5rem;max-width:420px;margin:1.5rem auto 0;">
        <input type="password" name="password" placeholder="{{ section.settings.placeholder }}" aria-label="Password">
        <button type="submit" class="button button--primary">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter store password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" }
  ]
}
{% endschema %}
