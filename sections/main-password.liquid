<section class="section">
  <div class="page-width page-width--narrow text-center">
    <p class="wordmark password__wordmark">{{ settings.wordmark | escape }}</p>
    <div class="rte measure password__text">{{ shop.password_message }}</div>

    {%- form 'storefront_password', class: 'stack', style: 'max-width: 24rem; margin: var(--space-xl) auto 0;' -%}
      <div class="field">
        <label class="field__label" for="PasswordInput">{{ 'customer.login_page.password' | t }}</label>
        <input class="field__input" id="PasswordInput" type="password" name="password" autocomplete="current-password">
      </div>
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors.messages.form }}</p>
      {%- endif -%}
      <button type="submit" class="button">{{ 'customer.login_page.sign_in' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "tag": "section",
  "settings": [

  ]
}
{% endschema %}
