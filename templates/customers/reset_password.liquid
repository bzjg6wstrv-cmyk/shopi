<section class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.recover_password.title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="pw">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password]" id="pw" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="pw2">{{ 'customer.login.password' | t }}</label>
        <input type="password" name="customer[password_confirmation]" id="pw2" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
