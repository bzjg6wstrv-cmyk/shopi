<section class="section">
  <div class="page-width page-width--narrow account-panel">
    <h1 class="h3">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>
    {%- form 'reset_customer_password', class: 'stack-lg', style: 'margin-top: var(--space-xl);' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input class="field__input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password">
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input class="field__input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
