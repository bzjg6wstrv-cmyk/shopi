<section class="section">
  <div class="page-width page-width--narrow account-panel">
    <h1 class="h3">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'stack-lg', style: 'margin-top: var(--space-xl);' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="RegisterFirst">{{ 'customer.register.first_name' | t }}</label>
        <input class="field__input" id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLast">{{ 'customer.register.last_name' | t }}</label>
        <input class="field__input" id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input class="field__input" id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input class="field__input" id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
