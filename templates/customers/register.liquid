<section class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="first">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" name="customer[first_name]" id="first" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="last">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" name="customer[last_name]" id="last" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="reg-email">{{ 'customer.register.email' | t }}</label>
        <input type="email" name="customer[email]" id="reg-email" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="reg-password">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="reg-password" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p style="margin-top:1.5rem;">
      <a class="link-underline" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
    </p>
  </div>
</section>
