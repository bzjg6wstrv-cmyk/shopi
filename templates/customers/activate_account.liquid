<section class="section">
  <div class="page-width page-width--narrow" style="max-width: 34rem;">
    <h1 class="h3">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>
    {%- form 'activate_customer_password', class: 'stack-lg', style: 'margin-top: var(--space-xl);' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        <input class="field__input" id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password">
      </div>
      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="field__input" id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      </div>
      <button type="submit" class="button">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="button button--secondary">{{ 'customer.activate_account.cancel' | t }}</button>
    {%- endform -%}
  </div>
</section>
