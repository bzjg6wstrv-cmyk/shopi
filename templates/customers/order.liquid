<section class="section">
  <div class="page-width">
    <a class="link-underline" href="{{ routes.account_url }}">&larr; {{ 'customer.account.title' | t }}</a>
    <h1 style="margin-top:1rem;">{{ 'customer.orders.order_number' | t }} {{ order.name }}</h1>
    <p class="card__vendor">{{ order.created_at | date: '%B %-d, %Y' }}</p>

    <div style="overflow-x:auto;margin-top:1.5rem;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="text-align:left;border-bottom:1px solid var(--color-border);">
            <th style="padding:0.75rem 1rem 0.75rem 0;">Product</th>
            <th style="padding:0.75rem 1rem;">{{ 'cart.quantity' | t }}</th>
            <th style="padding:0.75rem 0 0.75rem 1rem;text-align:right;">{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line in order.line_items -%}
            <tr style="border-bottom:1px solid var(--color-border);">
              <td style="padding:0.75rem 1rem 0.75rem 0;">{{ line.title }}</td>
              <td style="padding:0.75rem 1rem;">{{ line.quantity }}</td>
              <td style="padding:0.75rem 0 0.75rem 1rem;text-align:right;">{{ line.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2" style="padding:1rem 1rem 0 0;text-align:right;font-weight:700;">{{ 'cart.subtotal' | t }}</td>
            <td style="padding:1rem 0 0 1rem;text-align:right;font-weight:700;">{{ order.total_price | money }}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</section>
