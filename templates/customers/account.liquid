<section class="section">
  <div class="page-width">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
      <h1>{{ 'customer.account.title' | t }}</h1>
      <a class="link-underline" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </div>
    <p>{{ customer.name | default: customer.email }}</p>

    <h2 style="margin-top:2rem;">{{ 'customer.account.order_history' | t }}</h2>
    {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="text-align:left;border-bottom:1px solid var(--color-border);">
                <th style="padding:0.75rem 1rem 0.75rem 0;">{{ 'customer.orders.order_number' | t }}</th>
                <th style="padding:0.75rem 1rem;">{{ 'customer.orders.date' | t }}</th>
                <th style="padding:0.75rem 1rem;">{{ 'customer.orders.payment_status' | t }}</th>
                <th style="padding:0.75rem 0 0.75rem 1rem;">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr style="border-bottom:1px solid var(--color-border);">
                  <td style="padding:0.75rem 1rem 0.75rem 0;"><a class="link-underline" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td style="padding:0.75rem 1rem;">{{ order.created_at | date: '%d.%m.%Y' }}</td>
                  <td style="padding:0.75rem 1rem;">{{ order.financial_status_label }}</td>
                  <td style="padding:0.75rem 0 0.75rem 1rem;">{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- else -%}
        <p>{{ 'customer.account.no_orders' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}

    <p style="margin-top:2rem;">
      <a class="button button--secondary" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t }}</a>
    </p>
  </div>
</section>
