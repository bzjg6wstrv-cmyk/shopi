{% layout none %}
<!doctype html>
{%- assign default_scheme = settings.color_schemes | first -%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- assign gift_card_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value }} · {{ shop.name }}</title>
    <style data-theme-tokens>{%- render 'css-variables' -%}</style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="color-{{ default_scheme.id }} color-scheme">
    <main class="section" role="main">
      <div class="page-width page-width--narrow text-center" style="max-width: 32rem;">
        <p class="wordmark" style="font-size: 1.25rem;">{{ settings.wordmark | escape }}</p>
        <h1 class="h3" style="margin-top: var(--space-xl);">
          {{ 'gift_cards.issued.title' | t: value: gift_card_value }}
        </h1>
        <p class="text-muted">{{ 'gift_cards.issued.subtext' | t }}</p>

        {{ gift_card.qr_identifier }}

        <p class="h4" style="margin-top: var(--space-xl); font-variant-numeric: tabular-nums;">
          {{ gift_card.code | format_code }}
        </p>

        {%- if gift_card.expires_on -%}
          {%- assign gift_card_expiry = gift_card.expires_on | date: '%d.%m.%Y' -%}
          <p class="text-muted text-body-sm">
            {{ 'gift_cards.issued.expires' | t: expiry: gift_card_expiry }}
          </p>
        {%- endif -%}

        <p style="margin-top: var(--space-xl);">
          <a class="button" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
        </p>
      </div>
    </main>
  </body>
</html>
