{%- comment -%} Predictive search modal — opened by the header search icon {%- endcomment -%}
<predictive-search class="search-modal" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
  <div class="search-modal__overlay" data-search-close></div>
  <div class="search-modal__panel">
    <form action="{{ routes.search_url }}" method="get" class="search-modal__form" role="search">
      {% render 'icon', name: 'search' %}
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="{{ 'general.search.search' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="button" class="header__icon" data-search-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </form>
    <div class="search-results" data-search-results aria-live="polite" aria-busy="false"></div>
  </div>
</predictive-search>
