{%- comment -%}
  Preisausgabe.
  Parameter:
    variant       – Variantenobjekt (bevorzugt), sonst wird product genutzt
    product       – Produktobjekt
    show_unit     – Grundpreis nach PAngV ausgeben (Standard: Theme Setting)
    class         – zusätzliche CSS-Klasse
  Es werden bewusst keine „ab“-Preise ausgegeben; siehe docs/00-KONZEPT.md.
{%- endcomment -%}
{%- liquid
  assign target = variant
  if target == blank and product != blank
    assign target = product.selected_or_first_available_variant
  endif

  assign price_value = target.price
  assign compare_value = target.compare_at_price

  assign show_unit_price = show_unit
  if show_unit == nil
    assign show_unit_price = settings.show_unit_price
  endif
-%}
<div class="price {% if compare_value > price_value %}price--on-sale{% endif %} {{ class }}">
  {%- if compare_value > price_value -%}
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__regular">{{ compare_value | money }}</s>
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
  {%- endif -%}
  <span class="price__current">{{ price_value | money }}</span>

  {%- if show_unit_price and target.unit_price_measurement -%}
    <span class="card__unit-price">
      <span class="visually-hidden">{{ 'products.product.unit_price' | t }}</span>
      {{ target.unit_price | money }}
      {{ 'general.accessibility.unit_price_separator' | t }}
      {%- if target.unit_price_measurement.reference_value != 1 %} {{ target.unit_price_measurement.reference_value }}{% endif %}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
