{%- comment -%}
  Eine auswählbare Duftkachel im Discovery Set.
  Angeboten wird ein Duft nur, wenn seine Probenvariante gerade verfügbar ist.
  Parameter: product, sample_keyword
{%- endcomment -%}
{%- liquid
  assign sample_variant = null
  assign keyword = sample_keyword | downcase
  for variant in product.variants
    assign variant_title_down = variant.title | downcase
    if keyword != blank and variant_title_down contains keyword
      assign sample_variant = variant
    endif
  endfor

  assign families_list = product.metafields.custom.duftfamilie.value
  assign family_text = ''
  if families_list != blank
    assign family_text = families_list | join: ' · '
  endif
  assign notes_top = product.metafields.custom.kopfnoten.value | join: ' '
  assign notes_base = product.metafields.custom.basisnoten.value | join: ' '
  assign search_index = product.title | append: ' ' | append: family_text | append: ' ' | append: notes_top | append: ' ' | append: notes_base | downcase
-%}
{%- if sample_variant and sample_variant.available -%}
  <label class="pick" data-pick data-search="{{ search_index | escape }}" data-family="{{ family_text | escape }}">
    <input
      type="checkbox"
      name="discovery-pick"
      value="{{ product.title | escape }}{% if family_text != blank %} · {{ family_text | escape }}{% endif %}"
      data-handle="{{ product.handle }}"
    >
    <span class="pick__inner">
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 300 }}" alt="" width="150" height="200" loading="lazy">
      {%- endif -%}
      <span class="pick__title">{{ product.title }}</span>
      {%- if family_text != blank -%}
        <span class="pick__family">{{ family_text }}</span>
      {%- endif -%}
    </span>
  </label>
{%- endif -%}
