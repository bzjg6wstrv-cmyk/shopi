{%- comment -%}
  Product card.
  Accepts: product (required)
  Usage: {% render 'card-product', product: product %}
{%- endcomment -%}
{%- liquid
  assign ratio_setting = settings.card_image_ratio
  assign ratio_class = 'ratio-square'
  if ratio_setting == 'portrait'
    assign ratio_class = 'ratio-portrait'
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign second_image = product.images[1]
  assign card_alt = product.featured_media.alt | default: product.title | escape
-%}
<div class="card reveal" data-product-card>
  <div class="card__media media {{ ratio_class }}"
    {% if ratio_setting == 'adapt' and product.featured_media %}style="aspect-ratio: {{ product.featured_media.aspect_ratio | default: 1 }};"{% endif %}>
    <div class="badges">
      {%- if product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- endif -%}
    </div>

    <a href="{{ product.url }}" class="card__media-link" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '200,300,400,500,600,800',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            class: 'media-main',
            alt: card_alt
        }}
        {%- if settings.card_hover_image and second_image -%}
          {{
            second_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '200,300,400,500,600,800',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              class: 'media-hover',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'media-main placeholder' }}
      {%- endif -%}
    </a>

    {%- if settings.card_show_quick_add and product.available -%}
      <div class="quick-add">
        {%- if product.variants.size == 1 -%}
          <product-form>
            <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="button">
                <span class="button__text" data-add="{{ 'products.product.add_to_cart' | t }}">{{ 'products.product.add_to_cart' | t }}</span>
                <span class="loading-spinner"></span>
              </button>
            </form>
          </product-form>
        {%- else -%}
          <a href="{{ product.url }}" class="button">{{ 'products.product.choose_options' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <span class="card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% render 'price', product: product %}
  </div>
</div>
