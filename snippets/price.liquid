{%- comment -%}
  Renders a price block.
  Accepts: product (required), variant (optional, overrides product price)
  Usage: {% render 'price', product: product %}
         {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
{%- endcomment -%}
{%- liquid
  if variant
    assign price = variant.price
    assign compare_at = variant.compare_at_price
    assign available = variant.available
    assign varies = false
  else
    assign price = product.price
    assign compare_at = product.compare_at_price
    assign available = product.available
    assign varies = product.price_varies
  endif

  assign on_sale = false
  if compare_at and compare_at > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}">
  {%- if varies -%}
    <span class="price__regular">{{ 'products.product.from_price' | t: price: product.price_min | money }}</span>
  {%- else -%}
    {%- if on_sale -%}
      <span class="price__sale">{{ price | money }}</span>
      <s class="price__compare">{{ compare_at | money }}</s>
    {%- else -%}
      <span class="price__regular">{{ price | money }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
