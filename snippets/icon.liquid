{%- comment -%}
  Funktionale Icons. Bewusst sehr klein gehalten – Marketing-Abschnitte
  arbeiten mit Typografie und Fläche, nicht mit Icons.
  Aufruf: {% render 'icon', name: 'search' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m12.6 12.6 4.4 4.4" stroke-linecap="round"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M4 6h12l-1 11H5L4 6Z" stroke-linejoin="round"/><path d="M7.5 6V4.6a2.5 2.5 0 0 1 5 0V6" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><circle cx="10" cy="7" r="3.2"/><path d="M4 17c0-3 2.7-5 6-5s6 2 6 5" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m5 5 10 10M15 5 5 15" stroke-linecap="round"/></svg>
  {%- when 'chevron' -%}
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="m3 4.5 3 3 3-3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3 10h14M12 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M8 3v10M3 8h10" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M3 8h10" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="m3 8.5 3.2 3.2L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
