{%- comment -%}
  Erkennt einen Scent Code in einer Sucheingabe und rendert einen direkten
  Treffer. Läuft serverseitig – funktioniert damit auch ohne JavaScript und
  auf der normalen Suchergebnisseite.

  Parameter: terms (die Sucheingabe)

  „47", „047", „vc47", „VC 047" und „VC-047" führen alle zum selben Code.
{%- endcomment -%}
{%- liquid
  assign prefix = settings.scent_code_prefix | default: 'VC'
  assign prefix_down = prefix | downcase
  assign prefix_len = prefix_down | size

  comment
    Dieselbe Regel wie im Eingabefeld: optionales Präfix, danach ausschließlich
    Ziffern. Trennzeichen sind nur nach dem Präfix erlaubt – „-5" ist damit
    kein Code, „VC-5" schon. Nach oben gibt es keine Grenze.
  endcomment
  comment
    Leerzeichen zählen nur außen und als Trennzeichen nach dem Präfix:
    „VC 071" ist ein Code, „1 2" nicht.
  endcomment
  assign body = terms | downcase | strip
  assign head = body | slice: 0, prefix_len
  if prefix_len > 0 and head == prefix_down
    assign body = body | remove_first: prefix_down
    assign body = body | replace: '-', '' | replace: '–', '' | replace: '_', '' | replace: '.', '' | replace: '#', '' | replace: ' ', ''
  endif

  comment
    Ziffernprüfung ohne regulären Ausdruck: Bleibt nach dem Entfernen aller
    Ziffern nichts übrig, bestand die Eingabe nur aus Ziffern.
  endcomment
  assign rest = body | replace: '0', '' | replace: '1', '' | replace: '2', '' | replace: '3', '' | replace: '4', ''
  assign rest = rest | replace: '5', '' | replace: '6', '' | replace: '7', '' | replace: '8', '' | replace: '9', ''

  comment
    Über die Länge prüfen, nicht über „blank": Liquid behandelt einen String
    aus reinen Leerzeichen als blank – „1 2" wäre sonst durchgerutscht.
  endcomment
  assign rest_len = rest | size
  assign digits = body
  assign number = digits | plus: 0

  assign has_code = false
  if digits != blank and rest_len == 0 and number > 0
    assign has_code = true
  endif

  comment
    Ist eine Liste vergebener Nummern hinterlegt, muss der Code darin stehen.
    Ohne Liste ist jede positive Nummer gültig.
  endcomment
  assign allow_raw = settings.valid_scent_codes | strip
  if has_code and allow_raw != blank
    assign has_code = false
    assign allow_entries = allow_raw | newline_to_br | replace: '<br />', ',' | split: ','
    for entry in allow_entries
      assign entry_digits = entry | downcase | remove: prefix_down | remove: '-' | remove: ' ' | remove: '#' | strip
      assign entry_number = entry_digits | plus: 0
      if entry_number == number
        assign has_code = true
      endif
    endfor
  endif

  if has_code
    if number < 10
      assign padded = '00' | append: number
    elsif number < 100
      assign padded = '0' | append: number
    else
      assign padded = number | append: ''
    endif
    assign code = prefix | append: '-' | append: padded

    assign matched_product = blank
    for candidate in settings.scent_code_collection.products limit: 60
      assign candidate_code = candidate.metafields.custom.scent_code.value | default: candidate.title | strip | upcase
      if matched_product == blank and candidate_code == code
        assign matched_product = candidate
      endif
    endfor

    assign target_url = ''
    assign target_meta = ''
    if matched_product != blank
      assign target_url = matched_product.url
      assign main_variant = matched_product.metafields.custom.hauptvariante.value
      if main_variant == blank
        assign main_variant = matched_product.selected_or_first_available_variant
      endif
      assign variant_price = main_variant.price | money
      assign target_meta = main_variant.title | append: ' · ' | append: variant_price
    else
      assign generic = settings.scent_code_product
      if generic != blank
        assign target_url = generic.url | append: '?code=' | append: code
      endif
    endif
  endif
-%}
{%- if has_code and target_url != blank -%}
  <a class="predictive__code" href="{{ target_url }}" role="option">
    <span>
      <span class="predictive__code-title">{{ code }}</span>
      {%- if target_meta != blank -%}
        <span class="predictive__code-meta">{{ target_meta }}</span>
      {%- else -%}
        <span class="predictive__code-meta">{{ 'sections.scent_code.code_help' | t }}</span>
      {%- endif -%}
    </span>
    <span class="predictive__code-cta">{{ 'sections.scent_code.order_cta' | t }}</span>
  </a>
{%- endif -%}
